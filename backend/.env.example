# Forest Fire Shield - Backend Environment Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Application
APP_NAME=Forest Fire Shield API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS (frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Weather API (Open-Meteo - free, no key required)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=15

# Database (PostgreSQL + PostGIS)
# Docker default: postgresql+psycopg://postgres:postgres@localhost:5432/forest_fire_shield
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/forest_fire_shield
AUTO_CREATE_SCHEMA=true
POSTGIS_REQUIRED=true

# Device Connectivity Thresholds (seconds)
DEVICE_CONNECTED_SECONDS=60
DEVICE_WARNING_SECONDS=180
FIRE_COOLDOWN_SECONDS=30
WEBSOCKET_PING_INTERVAL_SECONDS=20

# Background Jobs
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_POLL_SECONDS=20
WEATHER_REFRESH_INTERVAL_SECONDS=900
FIRE_EVENT_CLEANUP_INTERVAL_SECONDS=30
DEVICE_STATUS_SYNC_INTERVAL_SECONDS=20
STALE_FIRE_EVENT_SECONDS=720

# Email Alerts (Gmail SMTP with App Password)
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_SUBJECT_PREFIX=[Forest Fire Shield]
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_RECIPIENTS=admin@example.com
ALERT_EMAIL_TIMEOUT_SECONDS=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# OpenTelemetry (Observability)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=forest-fire-shield-api
OTEL_SERVICE_NAMESPACE=forest-fire-shield
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# Grafana (for observability stack)
GRAFANA_DASHBOARD_URL=http://localhost:3000

# Simulation Defaults
SIMULATION_DEFAULT_HOURS=6
SIMULATION_DEFAULT_CELL_SIZE_M=45
SIMULATION_ACTIVE_BURN_HOURS=2
SIMULATION_MAX_CELLS=3500

# Default Device
DEFAULT_DEVICE_CODE=FFS_ESP32_01

# Sensor Thresholds (analog values - adjust for your hardware)
MQ2_ANALOG_THRESHOLD=1100
MQ4_ANALOG_THRESHOLD=2000
MQ7_ANALOG_THRESHOLD=4000
MQ135_ANALOG_THRESHOLD=2850